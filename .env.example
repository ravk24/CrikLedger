# --- Public reads (anon views only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Transactional writes: Supabase transaction pooler (port 6543) ---
# IPv4-safe; required on Vercel (direct db.*:5432 is IPv6-only there).
DATABASE_URL=

# --- Server-only Supabase key (never shipped to the browser) ---
# Dashboard -> Project Settings -> API keys. FILL THIS IN.
SUPABASE_SERVICE_ROLE_KEY=

# --- Custom auth + cron ---
SESSION_SECRET=
CRON_SECRET=
